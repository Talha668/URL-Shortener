# Flask Core
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///instance/urls.db
# DATABASE_URL=postgresql://user:password@localhost:5432/urlshortener

# URL Shortener Settings
SHORT_URL_LENGTH=6
SHORT_URL_CHARS=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789
BASE_URL=http://localhost:5000
# BASE_URL=https://short.link

# Rate Limiting (optional - using Flask-Limiter)
RATELIMIT_STORAGE_URI=memory://
# RATELIMIT_STORAGE_URI=redis://localhost:6379

# Cache (Redis - optional)
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TIMEOUT=300

# Analytics (optional)
TRACK_CLICKS=True
TRACK_REFERER=True
TRACK_IP=False

# Cleanup (optional - delete expired URLs)
AUTO_CLEANUP_EXPIRED=False
DEFAULT_EXPIRY_DAYS=365